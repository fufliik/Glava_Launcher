import { Logic, Color, Enabled } from "logic.slint";
import { Button } from "std-widgets.slint";

export component Bar inherits Rectangle {
    z: 3;
    x: 315px; y: 40px;

    width: 380px;
    height: 60px;
    opacity: Enabled.hotbar ? 1.0 : 0.0;
    animate opacity {duration: 200ms; easing: ease-in-out;}


    Rectangle {
        background: Color.background;
        border-radius: 20px;
        border-color: Color.primary;
        border-width: 0.5px;
    }

    Rectangle {
        Text {
            x: parent.width - self.width - 20px;
            y: (parent.height - self.height) / 2;
            horizontal-alignment: right;
            text: Logic.progress_bar;
            color: Color.qwer;
        }

        Text {
            x: 70px;
            y: (parent.height - self.height) / 2;
            horizontal-alignment: right;
            text: Logic.status_bar;
            color: Color.qwer;
            //фикс расположение нн
            }




        // и иконка загрузки

    }





}